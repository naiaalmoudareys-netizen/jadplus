{
  "expo": {
    "name": "JAD+",
    "slug": "jadplus",
    "scheme": "jadplus",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "ae.jadglobal.jadplus",
      "supportsTablet": false
    },
    "android": {
      "package": "ae.jadglobal.jadplus"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "JAD+ uses your photos only when you choose to add one to a request.",
          "cameraPermission": "JAD+ uses the camera only when you choose to photograph something for a request.",
          "microphonePermission": false
        }
      ]
    ],
    "icon": "./assets/brand/logo/icon-1024.png",
    "backgroundColor": "#F4F0EB"
  }
}
