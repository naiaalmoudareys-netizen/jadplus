<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Mobile_Match_Key__c</fullName>
    <description>JAD+ sign-in by mobile number: last 9 digits of the mobile (or phone), without spaces or signs. Same rule as Lead.Phone_Match_Key__c. Read by JADPlusIdentity only.</description>
    <externalId>false</externalId>
    <formula>RIGHT(
  SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(
    IF(NOT(ISBLANK(PersonMobilePhone)), PersonMobilePhone, Phone),
  "+", ""), " ", ""), "-", ""), "(", ""), ")", ""), ".", ""),
  9)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Mobile Match Key</label>
    <required>false</required>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
